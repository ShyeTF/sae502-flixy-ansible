# {{ ansible_managed }}
# Configuration de l'api Flixy pour la copie SAE. Secrets de TEST uniquement (Vault).
APP_NAME=Flixy SAE
NODE_ENV=production
APP_PORT={{ ports.api }}
TRUST_PROXY=1
WEB_HOST=https://{{ flixy_public_host }}
APP_HOST=https://{{ flixy_public_host }}

DATABASE_URI=postgresql://{{ postgres_user }}:{{ vault_postgres_password | urlencode }}@postgres:5432/{{ postgres_db }}
VALKEY_URI=redis://:{{ vault_valkey_password | urlencode }}@valkey:6379

EMAIL_SENDER=no-reply@flixy-sae.local

JWT_SECRET={{ vault_jwt_secret }}
JWT_LIFETIME={{ jwt_lifetime }}
JWT_MFA_LIFETIME={{ jwt_mfa_lifetime }}
JWT_RESTRICTED_LIFETIME={{ jwt_restricted_lifetime }}

CLOUDFLARE_SECRET={{ vault_cloudflare_secret }}
TURNSTILE_SECRET={{ vault_turnstile_secret }}

S3_ENDPOINT=http://minio:9000
S3_REGION={{ s3_region }}
S3_ACCESS_KEY={{ vault_minio_root_user }}
S3_SECRET_KEY={{ vault_minio_root_password }}
S3_BUCKET={{ minio_bucket }}

MEDIA_PATH={{ data_path }}
TMDB_SECRET={{ vault_tmdb_api_key }}

# Radarr (vm-media), port 7878 filtre DOCKER-USER : seule vm-app passe
RADARR_URL=http://{{ media_ip }}:{{ ports.radarr }}
RADARR_SECRET={{ vault_radarr_api_key }}
RADARR_WEBHOOK_SECRET={{ vault_radarr_webhook_secret }}
RADARR_PATH={{ data_path }}/films
RADARR_PROFILE={{ flixy_radarr_profile_id }}

# Pas de Sonarr dans la SAE (films uniquement), mais l'api exige ces variables
SONARR_URL=http://sonarr.invalid:8989
SONARR_SECRET={{ vault_sonarr_secret }}
SONARR_WEBHOOK_SECRET={{ vault_sonarr_webhook_secret }}
SONARR_PATH={{ data_path }}/series
SONARR_PROFILE=1

# Connexion Google / Apple non utilisee dans la demo (valeurs factices obligatoires)
GOOGLE_CLIENT_ID={{ vault_google_client_id }}
GOOGLE_CLIENT_SECRET={{ vault_google_client_secret }}
APPLE_CLIENT_ID={{ vault_apple_client_id }}
APPLE_TEAM_ID={{ vault_apple_team_id }}
APPLE_KEY_ID={{ vault_apple_key_id }}
APPLE_PRIVATE_KEY={{ vault_apple_private_key }}
